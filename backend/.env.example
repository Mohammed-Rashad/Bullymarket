BULLYMARKET_ENVIRONMENT=development
BULLYMARKET_DATABASE_URL=postgresql+asyncpg://bullymarket:bullymarket@localhost:5432/bullymarket
BULLYMARKET_JWT_SECRET=replace-this-with-at-least-32-random-bytes
BULLYMARKET_ACCESS_TOKEN_MINUTES=1440
BULLYMARKET_DEFAULT_STARTING_BALANCE=1000
BULLYMARKET_DEFAULT_LIQUIDITY_SEED=100
BULLYMARKET_MINIMUM_TRADE_AMOUNT=1
BULLYMARKET_REFILL_AMOUNT=500
BULLYMARKET_REFILL_INTERVAL_DAYS=7
BULLYMARKET_CORS_ORIGINS=["http://localhost:3000"]

# Docker Compose settings
POSTGRES_DB=bullymarket
POSTGRES_USER=bullymarket
POSTGRES_PASSWORD=bullymarket
POSTGRES_PORT=5432
API_PORT=8000
