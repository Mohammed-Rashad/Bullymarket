BULLYMARKET_ENVIRONMENT=development
BULLYMARKET_DATABASE_URL=postgresql+asyncpg://bullymarket:bullymarket@localhost:5432/bullymarket
BULLYMARKET_JWT_SECRET=replace-this-with-at-least-32-random-bytes
BULLYMARKET_ACCESS_TOKEN_MINUTES=1440
BULLYMARKET_DEFAULT_STARTING_BALANCE=1000
BULLYMARKET_DEFAULT_LIQUIDITY_SEED=100
BULLYMARKET_DEFAULT_LMSR_LIQUIDITY=100
BULLYMARKET_MINIMUM_TRADE_AMOUNT=1
BULLYMARKET_REFILL_AMOUNT=500
BULLYMARKET_REFILL_INTERVAL_DAYS=7
BULLYMARKET_CORS_ORIGINS=["http://localhost:3000"]
BULLYMARKET_FRONTEND_URL=http://localhost:3000
BULLYMARKET_VERIFICATION_CODE_MINUTES=10
BULLYMARKET_VERIFICATION_MAX_ATTEMPTS=5
BULLYMARKET_VERIFICATION_RESEND_SECONDS=60

# Brevo SMTP. Cloudflare hosts the domain DNS records; Brevo sends the mail.
BULLYMARKET_EMAIL_ENABLED=false
BULLYMARKET_SMTP_HOST=smtp-relay.brevo.com
BULLYMARKET_SMTP_PORT=587
BULLYMARKET_SMTP_SECURITY=starttls
BULLYMARKET_SMTP_USERNAME=
BULLYMARKET_SMTP_PASSWORD=
BULLYMARKET_EMAIL_FROM_ADDRESS=no-reply@example.com
BULLYMARKET_EMAIL_FROM_NAME=BullyMarket
BULLYMARKET_NOTIFICATION_WORKER_INTERVAL_SECONDS=30
BULLYMARKET_EMAIL_DELIVERY_BATCH_SIZE=20
BULLYMARKET_MEDIA_ROOT=uploads
BULLYMARKET_IMAGE_MAX_BYTES=5242880

# Docker Compose settings
POSTGRES_DB=bullymarket
POSTGRES_USER=bullymarket
POSTGRES_PASSWORD=bullymarket
POSTGRES_PORT=5432
API_PORT=8000
